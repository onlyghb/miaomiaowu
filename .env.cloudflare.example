# Copy to .env.cloudflare and enter the tunnel token from Cloudflare.
# The real .env.cloudflare file is excluded from Git and Docker builds.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: use your own GHCR image (lowercase owner/repository).
# MMW_IMAGE=ghcr.io/your-github-name/miaomiaowu:main

# Optional: pin a tested cloudflared image tag or digest.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
